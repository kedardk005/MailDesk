PORT=5015
MONGO_URI=mongodb://localhost:27017/maildesk

# JWT_SECRET must be high-entropy CSPRNG output, not a human-authored phrase.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your_jwt_secret_key_here

# Set to 'production' in production: suppresses stack traces in error responses.
NODE_ENV=development
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5015/api/gmail/oauth/callback
FRONTEND_URL=http://localhost:5173
# --- Outbound email: Brevo (ex-Sendinblue) transactional API ---------------
# Replaces Gmail SMTP. Create a key at
#   Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key
# BREVO_SENDER_EMAIL must be an address you have VERIFIED in Brevo under
# Senders, Domains & Dedicated IPs -> Senders. An unverified sender is
# rejected with 400 and the message is dead-lettered, not retried.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=K M KOTHARI
# Optional: where replies go, if different from the sender.
BREVO_REPLY_TO=
GEMINI_API_KEY=your_gemini_api_key_here

# Security Hardening Variables
# TOKEN_ENCRYPTION_KEY must be exactly 32 bytes, formatted as Hex (64 characters) or Base64 (44 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here_generate_with_crypto_randomBytes
OAUTH_STATE_SECRET=your_oauth_state_signing_secret_here

# Application / Behaviour Variables
#
# APP_TIMEZONE: IANA timezone used to interpret deadlines that carry no UTC
# offset. A bare date ("2026-08-05") becomes END OF DAY in this zone, and a
# naive date-time ("2026-08-05T17:00") is read as wall-clock time in this zone.
# Everything is stored in UTC. Default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# SEED_CLIENTS: set to 'true' to insert the demo client list on startup. Only
# applies when the Client collection is completely empty. Leave unset/false in
# production — seeded demo clients corrupt per-client reporting. Default: false
SEED_CLIENTS=false

# SHUTDOWN_TIMEOUT_MS: how long graceful shutdown waits for in-flight requests
# to drain on SIGTERM/SIGINT before forcing exit. Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Backend optimization layer
#
# EVERY variable below has a working default. In particular, REDIS_URL being
# UNSET is a fully supported configuration: the cache falls back to a bounded
# in-process LRU, the queue to an in-process runner, the cron lock to an
# in-process guard, and the rate limiter to its in-memory store.
# ---------------------------------------------------------------------------

# REDIS_URL: when set, enables the shared cache, BullMQ job queues, the
# distributed cron lock, the Socket.io adapter and the shared rate-limit store.
# Required before running more than one replica. Default: unset (single instance)
# REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# --- Logging ---
# LOG_LEVEL: pino level (trace|debug|info|warn|error|fatal).
# Default: debug outside production, info in production.
LOG_LEVEL=info

# --- MongoDB connection pool / timeouts ---
# Previously mongoose.connect() was called with NO options, which meant
# socketTimeoutMS: 0 (infinite) — a hung query held its pool connection forever.
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=60000
# MONGO_AUTO_INDEX: leave unset to auto-index outside production only. In
# production run `node scripts/syncIndexes.js --apply` as a deploy step.
# MONGO_AUTO_INDEX=false

# --- HTTP server ---
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=66000
# Must EXCEED the load balancer / nginx idle timeout or you get random 502s.
KEEPALIVE_TIMEOUT_MS=65000
COMPRESSION_THRESHOLD=1024
JSON_BODY_LIMIT=1mb

# --- Rate limiting ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=300
AI_RATE_LIMIT_PER_MINUTE=10

# --- Pagination (docs/audits/API-LIST-CONTRACT.md) ---
# LIST_LEGACY_CAP: hard cap applied when a caller sends no `page` parameter.
LIST_LEGACY_CAP=200

# --- Cache ---
CACHE_MAX_ITEMS=2000
CACHE_DEFAULT_TTL=60
CACHE_PREFIX=md
CACHE_TTL_RULES=300
CACHE_TTL_CLIENTS=600
CACHE_TTL_REPORT=900
CACHE_TTL_DASHBOARD=60
# CACHE_TTL_USER: authenticated-user lookup. Kept short because it caches the
# revocation signals (tokenVersion/status/deletedAt); every write path that
# changes them also busts the key explicitly.
CACHE_TTL_USER=30
CACHE_TTL_AI=2592000

# --- Job queue ---
QUEUE_CONCURRENCY=3
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_MAX_RECORDS=500
QUEUE_RECORD_TTL_MS=3600000

# --- Gmail sync ---
GMAIL_TIMEOUT_MS=20000
GMAIL_RETRY_ATTEMPTS=3
# Gmail allows 250 quota units/sec/user and messages.get costs 5, so 10 in
# flight is a safe ceiling.
GMAIL_SYNC_CONCURRENCY=10
GMAIL_ATTACHMENT_CONCURRENCY=5
GMAIL_ACCOUNT_CONCURRENCY=2
GMAIL_MAX_RESULTS=150
GMAIL_JOB_ATTEMPTS=3

# --- Outbound SMTP ---
# Brevo is one HTTPS POST, so the SMTP pool/greeting/socket timeouts are gone.
BREVO_TIMEOUT_MS=15000
# Override only for a Brevo regional endpoint or a test double.
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_JOB_ATTEMPTS=5

# --- Gemini ---
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=15000
AI_RETRY_ATTEMPTS=3
AI_JOB_ATTEMPTS=2
# How long POST /api/ai/summarize-email waits for the job before returning 202.
AI_INLINE_WAIT_MS=20000

# --- Scheduled jobs ---
CRON_OVERDUE_PATTERN=*/5 * * * *
CRON_SYNC_PATTERN=*/10 * * * *
CRON_OVERDUE_BATCH=1000

# --- Background scans ---
KEYWORD_BACKFILL_BATCH=200
KEYWORD_BACKFILL_MAX_BATCHES=100
BULK_APPROVE_MAX=500

# --- Token migration guard ---
# decrypt() now THROWS instead of returning the ciphertext as if it were a
# token. Legacy UNENCRYPTED tokens still pass through while this is true.
# Run `node scripts/encryptExistingTokens.js`, then set this to false.
ALLOW_LEGACY_PLAINTEXT_TOKENS=true

# --- Activity log (structured audit fields, WAVE2 gap S-2) ---
# Bounds on attacker-influenced audit values. `User-Agent` is unbounded on the
# wire, and a before/after snapshot must never grow into a storage problem.
ACTIVITY_MAX_USER_AGENT=400
ACTIVITY_MAX_LABEL=300
ACTIVITY_MAX_CHANGE_BYTES=4000

# --- Notification preferences (WAVE2 gap S-12) ---
# TTL for the cached per-user preference lookup. Read on every notification
# write; explicitly invalidated on every preference change, so this only bounds
# staleness after an out-of-band write.
CACHE_TTL_NOTIF_PREFS=60

# --- Email bulk operations (WAVE2 gaps S-15 / S-16) ---
# Ceiling for DELETE /api/gmail/emails and PATCH /api/gmail/emails/read.
EMAIL_BULK_MAX=200

# --- Session tokens ---
# Lifetime of a signed session JWT. Applies to login and to the replacement
# token returned by PUT /api/users/change-password (WAVE2 gap S-6).
JWT_EXPIRES_IN=7d

# --- F-1 email threading ---
# Maximum messages returned by GET /api/gmail/threads/:threadId (and the number
# whose threadPosition is maintained). A conversation longer than this is
# pathological, and the thread detail route opts into message BODIES, so an
# unbounded read here is the same OOM the old list response had.
THREAD_MESSAGE_CAP=200
# Ceiling on the `participants[]` array carried by one thread list row.
THREAD_PARTICIPANT_CAP=12
# Ceiling on the thread-id set resolved by a message-level narrowing filter
# (`q` / dateFrom / dateTo) on GET /api/gmail/threads.
THREAD_MATCH_CAP=2000

# --- F-2 SLA analytics ---
# Default targets, in minutes. Used when no SlaPolicy row exists, so the SLA
# endpoints work on a database that has never been configured. A `global`
# SlaPolicy row overrides these; a per-client row overrides that.
SLA_FIRST_RESPONSE_MINUTES=240
SLA_RESOLUTION_MINUTES=1440
# Optional business-hours calendar. OFF by default: with it off, elapsed time is
# plain wall-clock, which is what every existing number in the app means.
SLA_BUSINESS_HOURS=false
SLA_BUSINESS_START_HOUR=9
# Exclusive. 18 means the working day ends at 18:00.
SLA_BUSINESS_END_HOUR=18
# ISO weekdays, 1 = Monday … 7 = Sunday.
SLA_BUSINESS_DAYS=1,2,3,4,5
# Zone the business calendar is resolved in. Defaults to APP_TIMEZONE.
SLA_TIMEZONE=
# Reporting-window clamps. Unbounded, the day-bucket loop and the business
# window list are a DoS reachable by any authenticated Head.
SLA_DEFAULT_RANGE_DAYS=30
SLA_MAX_RANGE_DAYS=366
# Ceiling on the number of business windows materialised into one pipeline.
SLA_MAX_BUSINESS_WINDOWS=500
# A reply can land after the end of the reporting range, so the business-window
# list is extended past dateTo by this many days.
SLA_WINDOW_LOOKAHEAD_DAYS=14
# TTLs for the SLA aggregates and for the policy lookup. The aggregates live
# under the `report:` cache prefix, so a task/email write already drops them.
CACHE_TTL_SLA=900
CACHE_TTL_SLA_POLICY=300

# --- F-3 AI action-item extraction ---
# POST /api/ai/extract-actions takes { emailId } or { threadId } — never a body
# payload. Everything below bounds what a HOSTILE email can make the response
# cost or contain; the model's output is untrusted data, not instructions.
# Maximum suggested actions returned. Anything beyond this is discarded.
AI_EXTRACT_MAX_ACTIONS=10
# Per-field string ceilings, in characters.
AI_EXTRACT_TITLE_MAX=200
AI_EXTRACT_DESCRIPTION_MAX=1000
AI_EXTRACT_CLIENT_MAX=200
# Prompt input ceilings: total document, and per message within a conversation.
AI_EXTRACT_INPUT_CHARS=6000
AI_EXTRACT_MESSAGE_CHARS=1500
# How many messages of a thread are fed to the model (the NEWEST ones).
AI_EXTRACT_THREAD_MESSAGES=10
# A suggested due date outside this window is discarded as a hallucination or an
# injection attempt rather than pre-filled into the task form.
AI_EXTRACT_DUE_DATE_MAX_DAYS=730
AI_EXTRACT_DUE_DATE_MIN_DAYS=365
# Ceiling on the raw model response we will even attempt to parse.
AI_EXTRACT_RAW_MAX=40000
# TTL for the content-addressed extraction cache. Keyed by a hash of the prompt
# version, the model and the document, so it needs no invalidation.
CACHE_TTL_AI_ACTIONS=2592000
# How long GET /api/ai/extract-actions/:jobId will resolve a job for the user
# who created it. Under BullMQ a job id is an incrementing integer, so the poll
# endpoint is bound to its requester rather than to a role.
AI_JOB_OWNER_TTL=3600

# --- F-4 collision detection (ephemeral socket presence) ---
# How long a viewer/composer entry survives without a heartbeat. The client
# should re-emit `thread:viewing` at roughly half this interval.
PRESENCE_TTL_SECONDS=45
# How often expired entries are swept and a changed roster re-broadcast.
PRESENCE_SWEEP_MS=15000
# Distinct threads one socket may be present in. A reading pane needs one.
PRESENCE_MAX_ROOMS_PER_SOCKET=5
# Ceiling on the participants carried by one broadcast.
PRESENCE_MAX_PARTICIPANTS=25
# How long a successful room authorization is trusted before it is re-checked
# against the database.
PRESENCE_AUTH_TTL_MS=60000
# Inbound presence events allowed per socket per minute.
PRESENCE_EVENTS_PER_MINUTE=120
