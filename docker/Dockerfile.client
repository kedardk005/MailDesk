# syntax=docker/dockerfile:1
# ---- Build stage ----
FROM node:22-alpine AS build

WORKDIR /app

COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ ./

# Vite inlines VITE_* vars at BUILD time, not runtime — they must be present here.
# Override per-environment with: docker build --build-arg VITE_API_URL=https://api.example.com/api
ARG VITE_API_URL=http://localhost:5015/api
ARG VITE_SOCKET_URL=http://localhost:5015
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

RUN npm run build

# ---- Runtime stage: static files behind nginx ----
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
