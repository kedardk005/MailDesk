# ---------------------------------------------------------------------------
# MailDesk / K M KOTHARI — client environment
# Copy to `.env` and adjust per environment. Vite only exposes VITE_* vars.
# NEVER put a secret in here: everything below ships to the browser.
# ---------------------------------------------------------------------------

# Base URL of the REST API, including the /api prefix.
VITE_API_URL=http://localhost:5015/api

# Origin of the Socket.io server (no path, no trailing slash).
VITE_SOCKET_URL=http://localhost:5015

# Minimum length for a NEW password, used only for the hint and the inline
# check. Leave it unset unless you have also set PASSWORD_MIN_LENGTH in the
# SERVER environment — the server is what actually enforces the rule, and the
# two must name the same number or the form will promise something the API
# refuses. Both sides default to 12 and clamp to [8, 64].
# VITE_PASSWORD_MIN_LENGTH=12
