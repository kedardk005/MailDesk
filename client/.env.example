# ---------------------------------------------------------------------------
# MailDesk / K M KOTHARI — client environment
# Copy to `.env` and adjust per environment. Vite only exposes VITE_* vars.
# NEVER put a secret in here: everything below ships to the browser.
# ---------------------------------------------------------------------------

# Base URL of the REST API, including the /api prefix.
VITE_API_URL=http://localhost:5015/api

# Origin of the Socket.io server (no path, no trailing slash).
VITE_SOCKET_URL=http://localhost:5015
